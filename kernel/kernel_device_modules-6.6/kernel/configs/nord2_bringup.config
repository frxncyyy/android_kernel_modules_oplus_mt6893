# The factory charging test kit is not required for normal operation.
# CONFIG_OPLUS_CHG_TEST_KIT is not set

# Charging still needs the MT6893 legacy MP2650/ZY0603 integration.
# Do not treat the inherited newer charging framework as hardware support.

# Newer SoC system-cache policy and host/VM scheduling are outside MT6893 bring-up.
# CONFIG_OPLUS_FEATURE_SLC is not set
# CONFIG_MTK_CROSS_SCHEDULER is not set

# Board identification is consumed by the panel, modem, and charger modules.
CONFIG_OPLUS_FEATURE_OPROJECT=m
CONFIG_OPLUS_FEATURE_OPLUSBOOT=m
CONFIG_OPLUS_FEATURE_BUILDVARIANT=m

# VMC (panel) and vtp (touch) use the detached legacy MT6360 LDO bank.
CONFIG_REGULATOR_MT6360_LDO_LEGACY=m

# No Nord 2 sensor drivers have been integrated into the ISP6S camera list yet.
# Avoid probing the unrelated reference board's image sensors during bring-up.
CONFIG_CUSTOM_KERNEL_IMGSENSOR=""
# CONFIG_DEVICE_MODULES_SND_SOC_MT6991 is not set
# CONFIG_DEVICE_MODULES_SND_SOC_MT6991_MT6681 is not set
