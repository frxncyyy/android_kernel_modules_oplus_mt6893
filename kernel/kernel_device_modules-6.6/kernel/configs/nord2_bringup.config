# The factory charging test kit is not required for normal operation.
# CONFIG_OPLUS_CHG_TEST_KIT is not set

# Standard BLP861 gauge and MP2650 status; charging policy remains pending.
CONFIG_NORD2_POWER=m

# CPU_DVFS needs explicit DT supplies and its module dependency closure.
CONFIG_MEDIATEK_CPU_DVFS=m
CONFIG_MTK_PLAT_POWER_6893=m
CONFIG_MTK_TINYSYS_MCUPM_SUPPORT=m
CONFIG_MTK_PPM_V3=m

# The installed Trustonic 500a firmware reports MCI 1.8 / NWD ABI 8.3.
# The newer 600 driver requires MCI 2.0 and cannot serve this board's HALs.
CONFIG_TRUSTONIC_TEE_SUPPORT=m
CONFIG_TRUSTONIC_TEE_VERSION="500"
# CONFIG_MICROTRUST_TEE_SUPPORT is not set
# The 500 TUI HAL is a template without Nord 2 display/input ownership handoff.
# CONFIG_TRUSTONIC_TRUSTED_UI is not set

# Newer SoC system-cache policy and host/VM scheduling are outside MT6893 bring-up.
# CONFIG_OPLUS_FEATURE_SLC is not set
# CONFIG_MTK_CROSS_SCHEDULER is not set

# The Bluetooth and rfkill cores are kernel built-ins on this board.  The
# stock kernel carries them in the image, and bluetooth.ko and rfkill.ko would
# export ninety-four and fifteen symbols that appear on the GKI protected
# export list, which no vendor module may re-export; built into the image they
# are ordinary unprotected kernel exports that vendor modules may import.
# cfg80211 stays a module and travels in the port's module set, matching the
# GKI split, where cfg80211 (unlike rfkill/Bluetooth) is a GKI module rather
# than a kernel-image export and its symbols are absent from the unprotected
# list.  The MediaTek parts of the stack (connadp, conninfra, connfem,
# wmt_chrdev_wifi, the gen4m Wi-Fi driver and bt_drv_6893) are shipped modules
# too.
CONFIG_RFKILL=y
CONFIG_BT=y

# Board identification is consumed by the panel, modem, and charger modules.
CONFIG_OPLUS_FEATURE_OPROJECT=m
CONFIG_OPLUS_FEATURE_OPLUSBOOT=m
CONFIG_OPLUS_FEATURE_BUILDVARIANT=m

# VMC (panel) and vtp (touch) use the detached legacy MT6360 LDO bank.
CONFIG_REGULATOR_MT6360_LDO_LEGACY=m

# No Nord 2 sensor drivers have been integrated into the ISP6S camera list yet.
# Avoid probing the unrelated reference board's image sensors during bring-up.
CONFIG_CUSTOM_KERNEL_IMGSENSOR=""
# CONFIG_DEVICE_MODULES_SND_SOC_MT6991 is not set
# CONFIG_DEVICE_MODULES_SND_SOC_MT6991_MT6681 is not set

# Select one DEVAPC implementation. The multi-platform defaults export
# register_devapc_vio_callback from three incompatible architectures; modpost
# then directs CMDQ to MT6765 while gpufreq needs the multi-AO provider.
CONFIG_DEVICE_MODULES_MTK_DEVAPC=m
CONFIG_DEVAPC_ARCH_MULTI=m
CONFIG_DEVAPC_MT6893=m
# CONFIG_DEVAPC_ARCH_COMMON is not set
# CONFIG_DEVAPC_MT6761 is not set
# CONFIG_DEVAPC_MT6765 is not set
# CONFIG_DEVAPC_MT6768 is not set
# CONFIG_DEVAPC_MT6781 is not set
# CONFIG_DEVAPC_MT6833 is not set
# CONFIG_DEVAPC_MT6853 is not set
# CONFIG_DEVAPC_MT6873 is not set
# CONFIG_DEVAPC_MT6877 is not set
# CONFIG_DEVAPC_MT6879 is not set
# CONFIG_DEVAPC_MT6886 is not set
# CONFIG_DEVAPC_MT6895 is not set
# CONFIG_DEVAPC_MT6897 is not set
# CONFIG_DEVAPC_MT6899 is not set
# CONFIG_DEVAPC_MT6983 is not set
# CONFIG_DEVAPC_MT6985 is not set
# CONFIG_DEVAPC_MT6989 is not set
# CONFIG_DEVAPC_MT6991 is not set


# MDP: build without the MTEE secure path, matching stock.
#
# Enabling this option adds -DCMDQ_SECURE_PATH_SUPPORT in the MDP Makefile, which compiles
# in the SVP/HDCP/SecCam secure path.  That path imports eight cmdq_sec_* symbols from
# cmdq-sec-drv, which needs the KREE_* TEE services from gz_tz_system, which needs TIPC from
# gz_ipc_mod, which needs get_smcnr_dev from gz_trusty_mod - a chain that does not resolve in
# this port and therefore cannot load.
#
# Stock never sets this option (its kernel config has no such line at all), so its MDP is
# built without the secure path.  Disabling it matches stock and drops the whole chain.  The
# secure path is for protected content playback; blur and transparency need the ordinary
# compositor path this enables, not the protected one.
#
# Note for future edits: keep this directive free of adjacent lines beginning with the
# literal option name.  merge_config.sh continues a definition across following comment
# lines that look like part of it, and an earlier version of this comment made the merged
# value a run-on of the comment text rather than the intended setting.
# CONFIG_MTK_MDP_MTEE_SUPPORT is not set

# ION, carried forward from 4.19.  The shipping vendor blobs on this device speak
# the ION ioctl ABI (vpud, libcodec2_vndk, libdpframework, libion_mtk) and only
# ever open /dev/ion.  6.6 dropped ION for dma-buf heaps, which those blobs do not
# use, so the 4.19 driver is built here instead.
CONFIG_ION=m
CONFIG_ION_SYSTEM_HEAP=y
CONFIG_ION_CARVEOUT_HEAP=y
CONFIG_ION_CHUNK_HEAP=y
CONFIG_ION_CMA_HEAP=y
# CONFIG_MTK_ION_SEC_HEAP is not set
